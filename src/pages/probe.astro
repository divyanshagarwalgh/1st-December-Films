---
const base = import.meta.env.BASE_URL || "";
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Timeout probe</title>
    <style>
      body { font: 14px/1.5 monospace; margin: 2rem; }
      button { margin-right: 1rem; padding: .5rem 1rem; }
      pre { background: #111; color: #eee; padding: 1rem; min-height: 20rem; white-space: pre-wrap; }
    </style>
  </head>
  <body>
    <h1>Webflow Cloud timeout probe</h1>
    <p>Base: <code>{base || "/"}</code></p>
    <button data-probe="stream">stream (45 s, 1 event/s)</button>
    <button data-probe="ttfb">ttfb (first byte at 25 s)</button>
    <button data-probe="idle">idle (25 s gap after event 9)</button>
    <pre id="log"></pre>
    <script is:inline define:vars={{ base }}>
      const log = document.getElementById("log");
      let es = null;
      function line(s) { log.textContent += new Date().toISOString().slice(11, 23) + "  " + s + "\n"; }
      document.querySelectorAll("button").forEach((b) => b.addEventListener("click", () => {
        if (es) es.close();
        log.textContent = "";
        const name = b.dataset.probe;
        const started = Date.now();
        line("open " + name);
        es = new EventSource(base + "/api/probe/" + name);
        es.onopen = () => line("onopen after " + (Date.now() - started) + " ms");
        es.addEventListener("tick", (e) => line("tick " + e.data + " (wall " + (Date.now() - started) + " ms)"));
        es.addEventListener("done", (e) => { line("done " + e.data + " (wall " + (Date.now() - started) + " ms)"); es.close(); });
        es.onerror = () => { line("ERROR/closed at wall " + (Date.now() - started) + " ms, readyState " + es.readyState); es.close(); };
      }));
    </script>
  </body>
</html>
