{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fdf-script",
  "compatibility_date": "2025-04-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fdf_script",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE",
      "id": "local"
    }
  ]
}
